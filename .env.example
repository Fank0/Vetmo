# === PostgreSQL ===
POSTGRES_USER=drafter
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=dota2_drafter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://drafter:changeme_local_only@postgres:5432/dota2_drafter

# === Backend (Draft Scoring API) ===
BACKEND_PORT=8000
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
OPENDOTA_TIMEOUT_SEC=15
OPENDOTA_MAX_RPS=1.0
# Веса формулы Score = w_c*Counter + w_s*Synergy + w_r*RoleFit + w_m*Meta
SCORE_W_COUNTER=0.55
SCORE_W_SYNERGY=0.15
SCORE_W_ROLE=0.15
SCORE_W_META=0.15
SMOOTHING_K=50.0

# === Frontend ===
FRONTEND_PORT=8080
# Переопределяется в браузере; по умолчанию тот же хост, порт 8000
BACKEND_URL=http://localhost:8000

# === n8n ===
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n_local
GENERIC_TIMEZONE=Europe/Moscow

# === Qdrant (OPTIONAL, профиль rag) ===
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=draft_scenarios
EMBEDDING_DIM=384
# Если пусто — backend работает без Qdrant (требование DoD №10)
ENABLE_RAG=false

# === LLM объяснения (OPTIONAL) ===
# Если пусто — используется детерминированный template fallback без выдумывания цифр
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
